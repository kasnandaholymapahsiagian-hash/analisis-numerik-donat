        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# 1. PARAMETER DESAIN DAN GRID\n",
        "# ==========================================\n",
        "# Skala: 1 siklus dash-kosong = 10 cm = 0.1 m\n",
        "# 1 kotak grid besar = 5 dash-kosong = 50 cm = 0.5 m\n",
        "h = 0.5  # Lebar langkah (meter)\n",
        "\n",
        "# Tinggi lambung konstan (3 grid = 1.5 m)\n",
        "tinggi = 1.5\n",
        "\n",
        "# Lebar lambung (W_i) dalam satuan grid untuk 37 titik data (i = 0 s.d. 36)\n",
        "lebar_grid = np.array([\n",
        "    0.5, 0.8, 1.0, 1.2, 1.4, 1.5,  # i = 0..5 (Transisi Depan)\n",
        "    1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5,\n",
        "    1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5,\n",
        "    1.5, 1.5, 1.5, 1.5, 1.5,        # i = 6..30 (Bagian Tengah Sejajar)\n",
        "    1.4, 1.2, 1.0, 0.8, 0.6, 0.4   # i = 31..36 (Transisi Belakang)\n",
        "])\n",
        "\n",
        "# Konversi lebar dari grid ke meter\n",
        "lebar_m = lebar_grid * h\n",
        "\n",
        "# Posisi sumbu x (meter)\n",
        "x = np.arange(len(lebar_grid)) * h\n",
        "\n",
        "# Luas penampang A(x) = Lebar(x) * Tinggi\n",
        "A = lebar_m * tinggi\n",
        "\n",
        "# ==========================================\n",
        "# 2. PERHITUNGAN INTEGRASI NUMERIK\n",
        "# ==========================================\n",
        "\n",
        "# A. Aturan Trapesium Komposit\n",
        "def composite_trapezoidal(A, h):\n",
        "    n = len(A) - 1\n",
        "    return (h / 2) * (A[0] + 2 * np.sum(A[1:n]) + A[-1])\n",
        "\n",
        "# B. Aturan Simpson 1/3 Komposit\n",
        "def composite_simpson_13(A, h):\n",
        "    n = len(A) - 1\n",
        "    sum_ganjil = np.sum(A[1:n:2])\n",
        "    sum_genap = np.sum(A[2:n:2])\n",
        "    return (h / 3) * (A[0] + 4 * sum_ganjil + 2 * sum_genap + A[-1])\n",
        "\n",
        "# Perhitungan Volume\n",
        "v_1_trapesium = composite_trapezoidal(A, h)\n",
        "v_total_trapesium = 2 * v_1_trapesium\n",
        "\n",
        "v_1_simpson = composite_simpson_13(A, h)\n",
        "v_total_simpson = 2 * v_1_simpson\n",
        "\n",
        "# ==========================================\n",
        "# 3. MENAMPILKAN HASIL DAN TABEL DATA\n",
        "# ==========================================\n",
        "df = pd.DataFrame({\n",
        "    'i': np.arange(len(A)),\n",
        "    'x (m)': x,\n",
        "    'Lebar W_i (grid)': lebar_grid,\n",
        "    'Lebar W_i (m)': lebar_m,\n",
        "    'Tinggi T_i (m)': tinggi,\n",
        "    'Luas A_i (m^2)': A\n",
        "})\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(\" TABEL DATA PENAMPANG LAMBUNG KAPAL KATAMARAN \")\n",
        "print(\"=\"*65)\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\" HASIL PERHITUNGAN INTEGRASI NUMERIK \")\n",
        "print(\"=\"*65)\n",
        "print(f\"1. METODE TRAPESIUM KOMPOSIT:\")\n",
        "print(f\"   - Volume 1 Lambung    : {v_1_trapesium:.5f} m^3\")\n",
        "print(f\"   - Total Volume 2 Lambung: {v_total_trapesium:.5f} m^3 ({v_total_trapesium*1000:.1f} Liter)\")\n",
        "print(\"-\" * 65)\n",
